# Configure these in Netlify server environment variables, never in browser JavaScript.
# Paste the complete Firebase service-account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT=
# Exact Firebase Storage bucket name, without gs://
FIREBASE_STORAGE_BUCKET=
# Exact deployed origin, including https://, without a trailing slash.
ALLOWED_ORIGIN=
# Server-side Gemini API. Enable API billing in the project owning this key if needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


