# Configure these in Netlify server environment variables, never in browser JavaScript.
# Paste the complete Firebase service-account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT=
# Exact Firebase Storage bucket name, without gs://
FIREBASE_STORAGE_BUCKET=
# Exact deployed origin, including https://, without a trailing slash.
ALLOWED_ORIGIN=
# OpenAI only: set in Netlify > Environment variables (Functions scope).
# Never paste the API key into public website code or the ZIP.
OPENAI_API_KEY=

# Phase 9 transactional email (OPTIONAL): without these, registration and admin approvals still work;
# application updates remain in the private status timeline, but emails are not sent.
# Never put these values in index.html, JS or frontend build output.
RESEND_API_KEY=
VICINIFY_FROM_EMAIL=
