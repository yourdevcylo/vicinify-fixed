rules_version = '2';

// Trusted endpoints own booking transitions and rating aggregates.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid));
    }

    // Email must be verified for WRITES (spam/abuse gate).
    // Reads stay open so unverified users can still browse.
    // users/{uid} create is exempt — the profile must exist before
    // the user can verify.
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 80
        && !value.matches("(?s).*[<>\\r\\n\\x00-\\x1f\\x7f].*")
        && value.matches("^[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,11}$");
    }
    function validPlaceName(value) {
      return value is string && value.size() >= 3 && value.size() <= 120
        && !value.matches("(?s).*[<>\\r\\n\\x00-\\x1f\\x7f].*")
        && value.matches("^[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,19}$");
    }
    function validPost(value) {
      return value is string && value.trim().size() >= 3 && value.size() <= 500
        && value.matches("(?s)^[\\s\\p{Z}]*[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,99}[\\s\\p{Z}]*$");
    }
    function validChat(value) {
      return value is string && value.trim().size() >= 1 && value.size() <= 2000
        && value.matches("(?s)^[\\s\\p{Z}]*[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,299}[\\s\\p{Z}]*$");
    }
    function validComment(value) {
      return value is string && value.trim().size() >= 1 && value.size() <= 500
        && value.matches("(?s)^[\\s\\p{Z}]*[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,99}[\\s\\p{Z}]*$");
    }
    function validDescription(value) {
      return value is string && value.size() <= 1000
        && (value.trim().size() == 0 || value.matches("(?s)^[\\s\\p{Z}]*[^\\s\\p{Z}]+([\\s\\p{Z}]+[^\\s\\p{Z}]+){0,199}[\\s\\p{Z}]*$"));
    }
    function optionalText(data,key,maximum) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maximum);
    }
    function validAutoReplies(data) {
      let answers=data.get('auto_reply_answers',{});
      return data.get('auto_reply_enabled',false) is bool
        && answers is map && answers.keys().hasOnly(['menu','hours','delivery','booking'])
        && (answers.get('menu','')=='' || validPost(answers.menu))
        && (answers.get('hours','')=='' || validPost(answers.hours))
        && (answers.get('delivery','')=='' || validPost(answers.delivery))
        && (answers.get('booking','')=='' || validPost(answers.booking));
    }
    function cooldownSeconds(scope) { return scope == 'chat' ? 2 : scope == 'comment' ? 5 : scope in ['place','report','claim'] ? 60 : 30; }
    function rateGate(scope, targetId) {
      let gate = getAfter(/databases/$(database)/documents/write_cooldowns/$(request.auth.uid + '_' + scope)).data;
      return gate.at == request.time && gate.targetId == targetId;
    }
    match /write_cooldowns/{gateId} {
      allow read: if false;
      allow create, update: if verifiedEmail()
        && request.resource.data.keys().hasOnly(['uid','scope','targetId','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.scope in ['chat','buzz','menu','comment','place','report','claim']
        && gateId == request.auth.uid + '_' + request.resource.data.scope
        && request.resource.data.targetId is string
        && request.resource.data.targetId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.at == request.time
        && (resource == null || request.time >= resource.data.at + duration.value(cooldownSeconds(request.resource.data.scope), 's'));
      allow delete: if false;
    }

    function messageGate(targetId, isText) {
      let path = /databases/$(database)/documents/message_limits/$(request.auth.uid);
      let gate = getAfter(path).data;
      return gate.at == request.time && gate.targetId == targetId
        && (!isText || !exists(path) || request.time >= get(path).data.at + duration.value(2,'s'));
    }
    match /message_limits/{userId} {
      allow get: if signedIn() && userId == request.auth.uid;
      allow list, delete: if false;
      allow create, update: if verifiedEmail() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','targetId','at','windowStartedAt','count'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.targetId is string
        && request.resource.data.targetId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 30
        && ((resource == null && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time)
          || (resource != null && request.resource.data.windowStartedAt == resource.data.windowStartedAt
            && request.time < resource.data.windowStartedAt + duration.value(60,'s')
            && request.resource.data.count == resource.data.count + 1)
          || (resource != null && request.time >= resource.data.windowStartedAt + duration.value(60,'s')
            && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time));
    }

    function isDeveloper() {
      return signedIn()
        && request.auth.uid == "Z45NZhQTgsTUX79WJ5ksCH8N3c02";
    }

    // The permanent admin account: once its profile holds role "admin",
    // no one (not even another admin) can demote it or delete the doc.
    // It is the recovery anchor for the whole project.
    function isPermanentAdminId(userId) {
      return userId == "Z45NZhQTgsTUX79WJ5ksCH8N3c02";
    }

    function isAdmin() {
      return isDeveloper()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    function isPlaceOwner(placeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/places/$(placeId))
        && get(/databases/$(database)/documents/places/$(placeId)).data.owner_uid == request.auth.uid;
    }

    match /account_deletions/{userId} { allow read, write: if false; }
    match /ownership_transfers/{placeId} { allow read, write: if false; }

    match /users/{userId} {
      // Single profile lookup (owners see a customer's display name).
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Bulk listing = scraping every user's email. Admin only.
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && validName(request.resource.data.fullName)
        && request.resource.data.role == "user";

      allow update: if (
          isAdmin()
          || (
            signedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
          )
        )
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) || validName(request.resource.data.fullName))
        // Permanent admin can never be demoted once it holds role "admin".
        && !(
          isPermanentAdminId(userId)
          && resource.data.role == "admin"
          && request.resource.data.role != "admin"
        );

      // Account removal is performed by the resumable server workflow.
      allow delete: if false;
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["fullName"])
        && validName(request.resource.data.fullName);
      allow delete: if false;
    }

    // Administrative ownership contact data must not live in public place documents.
    match /private_places/{placeId} {
      allow read, write: if isAdmin();
    }

    match /places/{placeId} {
      allow read: if resource.data.approval_status == "approved"
        || (resource.data.get("accountDeleted",false) == true && resource.data.approval_status == "archived") || isAdmin()
        || (signedIn() && (resource.data.owner_uid == request.auth.uid || resource.data.addedBy == request.auth.uid));

      allow create: if verifiedEmail()
        && placeId.matches('^[A-Za-z0-9_-]{1,180}$')
        && rateGate('place',placeId) && request.resource.data.createdAt == request.time
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.owner_uid == null
        && request.resource.data.get("avgRating", 0) == 0
        && request.resource.data.get("reviewCount", 0) == 0
        && request.resource.data.get("ratingSum", 0) == 0
        && (isAdmin() || (request.resource.data.get("is_verified", false) == false
          && request.resource.data.get("is_premium", false) == false
          && request.resource.data.get("is_featured", false) == false
          && request.resource.data.get("claimStatus", "unclaimed") in ["unclaimed", "pending"]))
        // Basic input sanity (client also enforces maxlength).
        && validPlaceName(request.resource.data.name) && validAutoReplies(request.resource.data)
        && validDescription(request.resource.data.get('description',''))
        && validDescription(request.resource.data.get('desc',''))
        && (
          !("suggestedBy" in request.resource.data)
          || request.resource.data.suggestedBy == request.auth.uid
        )
        && (
          !("approval_status" in request.resource.data)
          || request.resource.data.approval_status == "pending"
          // Admins may publish directly — no self-approval step needed.
          || (isAdmin() && request.resource.data.approval_status == "approved")
        );

      allow update: if (isAdmin() && validAutoReplies(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || validPlaceName(request.resource.data.name))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || validDescription(request.resource.data.description))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['desc']) || validDescription(request.resource.data.desc)))
        || (
          // Owner edits their place, but may NOT transfer ownership,
          // change who added it, approve their own place, or touch
          // verification/trust fields (self-verification hole closed).
          verifiedEmail()
          && isPlaceOwner(placeId) && !resource.data.get('ownershipTransferPending',false) && validAutoReplies(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || validDescription(request.resource.data.description))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['desc']) || validDescription(request.resource.data.desc))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || validPlaceName(request.resource.data.name))
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(["owner_uid", "owner_email", "addedBy", "approval_status", "ownershipTransferPending",
                        "is_verified", "claimStatus",
                        "is_premium", "is_featured", "avgRating", "reviewCount", "ratingSum"])
        );

      allow delete: if isAdmin();
    }

    match /favorites/{favId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || favId.matches(request.auth.uid + "_.*")
          || resource.data.userId == request.auth.uid
        );

      allow create: if verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.placeId is string
        && favId == request.auth.uid + '_' + request.resource.data.placeId
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
        && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.get('owner_uid', '') != request.auth.uid;

      allow update: if verifiedEmail()
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.userId == resource.data.userId
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if verifiedEmail() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.get("isPublic", false) == true || isAdmin()
        || (signedIn() && (resource.data.userId == request.auth.uid || isPlaceOwner(resource.data.placeId)));
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || isPlaceOwner(resource.data.placeId)
        );

      // Server endpoint validates schedule, identity, place and initial payment state atomically.
      allow create: if false;

      allow update: if verifiedEmail() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["customerReadAt", "customerReadBy", "customerRead", "readByCustomer", "readByCustomerAt"]))
        || ((isPlaceOwner(resource.data.placeId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerReadAt", "ownerReadBy", "ownerRead", "readByOwner", "readByOwnerAt"]))
        || ((isPlaceOwner(resource.data.placeId) || isAdmin())
          && resource.data.status in ["received", "fulfilled", "delivered", "cancelled", "rejected"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedBy"])
          && request.resource.data.deletedBy == resource.data.get("deletedBy", []).removeAll([request.auth.uid]).concat([request.auth.uid]))
      );
      allow delete: if false;
    }

    match /messages/{msgId} {
      function participant() {
        return signedIn() && (resource.data.userId == request.auth.uid || isPlaceOwner(resource.data.placeId) || isAdmin());
      }
      function cardMirror() {
        let order = get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data;
        return resource.data.type == "booking_card"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","bookingStatus","updatedAt","refundPercent","paymentProofUrl"])
          && request.resource.data.status == order.status && request.resource.data.bookingStatus == order.status
          && request.resource.data.get("refundPercent", 50) == order.get("refundPercent", 50)
          && request.resource.data.get("paymentProofUrl", "") == order.get("paymentProofUrl", "");
      }
      allow read: if participant();
      allow create: if verifiedEmail()
        && msgId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.placeId is string
        && request.resource.data.userId is string
        && !exists(/databases/$(database)/documents/account_deletions/$(request.resource.data.userId))
        && request.resource.data.createdAt == request.time
        && messageGate(msgId,request.resource.data.type == "text")
        && !request.resource.data.keys().hasAny(['isAutoReply','autoReplyTopic','replyTo'])
        && (!('quickQuestion' in request.resource.data) || request.resource.data.quickQuestion in ['menu','hours','delivery','booking'])
        && optionalText(request.resource.data,'placeName',120)
        && optionalText(request.resource.data,'userName',120)
        && optionalText(request.resource.data,'senderName',120)
        && optionalText(request.resource.data,'notes',1000)
        && optionalText(request.resource.data,'orderDetails',1000)
        && optionalText(request.resource.data,'address',1000)
        && optionalText(request.resource.data,'paymentReference',80)
        && optionalText(request.resource.data,'paymentMethod',80)
        && (request.resource.data.get('reply',null) == null || validChat(request.resource.data.reply))
        && (request.resource.data.get('feedback','') == '' || validChat(request.resource.data.feedback))
        && (request.resource.data.get('text','') == '' || validChat(request.resource.data.text))
        && (request.resource.data.type != "text" || (validChat(request.resource.data.text)
          && request.resource.data.get("status", "sent") == "sent"
          && request.resource.data.get('reply',null) == null
          && request.resource.data.get('deliveredAt',null) == null
          && request.resource.data.get('seenAt',null) == null
          && request.resource.data.keys().hasOnly(['placeId','placeName','userId','userName','type','text','status','deliveredAt','seenAt','senderUid','senderRole','senderName','createdBy','createdAt','reply','quickQuestion'])))
        && request.resource.data.senderUid == request.auth.uid && request.resource.data.createdBy == request.auth.uid
        && ((request.resource.data.userId == request.auth.uid && request.resource.data.senderRole == "customer"
              && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.approval_status == "approved"
              && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.owner_uid != request.auth.uid
              && request.resource.data.type in ["text","system_update","requirement_response","feedback_request","feedback_response"])
          || ((isPlaceOwner(request.resource.data.placeId) || isAdmin()) && request.resource.data.senderRole == "owner"
              && request.resource.data.type in ["text","system_update","requirement_request","completion_request"]));
      allow update: if verifiedEmail() && participant()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reply','feedback'])
          || (messageGate(msgId,true)
            && (request.resource.data.get('reply',null) == null || validChat(request.resource.data.reply))
            && (request.resource.data.get('feedback','') == '' || validChat(request.resource.data.feedback))))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["userId","placeId","senderUid","senderRole","createdBy","createdAt","type","bookingId","transactionId"])
        && (
        (resource.data.type == "booking_card" && cardMirror())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedBy"])
          && request.resource.data.deletedBy == resource.data.get("deletedBy", []).removeAll([request.auth.uid]).concat([request.auth.uid]))
        || (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["customerReadAt","customerReadBy","customerRead","readByCustomer","readByCustomerAt"]))
        || ((isPlaceOwner(resource.data.placeId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerReadAt","ownerReadBy","ownerRead","readByOwner","readByOwnerAt"]))
        || (resource.data.type == "text" && resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","deliveredAt","seenAt"])
          && request.resource.data.status in ["delivered","seen"])
        || (resource.data.type != "booking_card"
          && (isPlaceOwner(resource.data.placeId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["requirementStatus","confirmedAt","updatedAt","reply","replyAt","repliedAt"]))
        || (resource.data.type == "completion_request"
          && (isPlaceOwner(resource.data.placeId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["transactionStatus","updatedAt"])
          && request.resource.data.transactionStatus == get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status)
        || (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["requirementStatus","submittedAt","updatedAt"])
          && request.resource.data.requirementStatus == "submitted")
        || (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["feedbackStatus","rating","satisfaction","feedback","updatedAt"])
          && request.resource.data.feedbackStatus in ["submitted", "feedback_submitted"])
        || (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["transactionStatus","customerConfirmedAt","updatedAt"])
          && request.resource.data.transactionStatus == "received"
          && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == "received")
      );
      allow delete: if isAdmin();
    }

    match /buzz_posts/{postId} {
      function reaction() {
        let old = resource.data.get("likedBy", []);
        let next = request.resource.data.likedBy;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes","likedBy"])
          && (next == old.removeAll([request.auth.uid]) || next == old.removeAll([request.auth.uid]).concat([request.auth.uid]))
          && request.resource.data.likes == next.size();
      }
      function comment() {
        let old = resource.data.get("comments", []);
        let next = request.resource.data.comments;
        let added = next[next.size()-1];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["comments"])
          && next.size() == old.size()+1 && next.size() <= 100 && next == old.concat([added])
          && added.authorUid == request.auth.uid
          && added.keys().hasOnly(["text","authorName","authorUid","createdAt"])
          && validComment(added.text) && optionalText(added,'authorName',80)
          && added.createdAt is int && added.createdAt >= 0 && rateGate('comment',postId);
      }
      allow read: if true;
      allow create: if verifiedEmail() && postId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.authorUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['authorEmail'])
        && optionalText(request.resource.data,'authorName',80)
        && optionalText(request.resource.data,'barangay',120)
        && request.resource.data.type in ['general','promo','event','tip','announcement']
        && optionalText(request.resource.data,'establishmentName',120)
        && optionalText(request.resource.data,'mediaUrl',2048)
        && validPost(request.resource.data.body) && rateGate('buzz',postId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.get("likes",0) == 0 && request.resource.data.get("likedBy",[]) == []
        && request.resource.data.get("comments",[]) == []
        && (!request.resource.data.get("isBusinessPost",false)
          || isPlaceOwner(request.resource.data.get("sourcePlaceId",request.resource.data.get("establishmentId",""))) || isAdmin());
      allow update: if verifiedEmail()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['body']) || validPost(request.resource.data.body))
        && (isAdmin() || reaction() || comment()
        || (resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["body","mediaUrl","updatedAt","type","barangay","establishmentName","authorName"])
          && validPost(request.resource.data.body) && rateGate('buzz',postId)
          && optionalText(request.resource.data,'authorName',80)
          && optionalText(request.resource.data,'establishmentName',120)
          && optionalText(request.resource.data,'mediaUrl',2048)));
      allow delete: if isAdmin() || (verifiedEmail() && resource.data.authorUid == request.auth.uid);
    }

    match /place_posts/{postId} {
      allow read: if true;

      allow create: if verifiedEmail()
        && request.resource.data.createdAt == request.time && rateGate('menu',postId)
        && (validPost(request.resource.data.body) || (request.resource.data.body == '' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() > 0))
        && (isAdmin() || isPlaceOwner(request.resource.data.placeId));

      allow update: if verifiedEmail()
        && request.resource.data.placeId == resource.data.placeId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['body'])
          || ((validPost(request.resource.data.body) || (request.resource.data.body == '' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() > 0)) && rateGate('menu',postId)))
        && (isAdmin() || isPlaceOwner(resource.data.placeId));
      allow delete: if verifiedEmail() && (isAdmin() || isPlaceOwner(resource.data.placeId));
    }

    match /admin_audit/{entryId} {
      // Written by admins as actions happen; readable only by admins.
      // Entries are never edited or deleted (append-only trail).
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // --- ADDED: these collections had NO rules (features were broken) ---

    match /business_claims/{claimId} {
      allow get: if isAdmin() || (signedIn() && claimId.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]+$'));
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && claimId == request.auth.uid + '_' + request.resource.data.placeId
        && rateGate('claim',claimId) && request.resource.data.createdAt == request.time
        && request.resource.data.get("status", "pending") == "pending"
        && !request.resource.data.keys().hasAny(["reviewedBy", "reviewedAt", "approvedBy"]);

      // Claimant edits own claim; admin reviews (approve/reject).
      allow update: if isAdmin()
        || (
          verifiedEmail()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["contactName","contactPhone","proofUrl","message","updatedAt"])
        );

      allow delete: if isAdmin()
        || (verifiedEmail() && resource.data.userId == request.auth.uid);
    }

    match /place_reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && rateGate('report',reportId) && request.resource.data.createdAt == request.time
        && validPost(request.resource.data.details);

      allow update, delete: if isAdmin();
    }

    // --- ADDED 2026-10-05 (Suki Card / loyalty). Tightened 2026-10-05 (v53 audit). ---
    // loyalty_cards/{cardId}: deterministic cardId = placeId + "_" + customerUid
    // (idempotent approval: double-tap cannot double-stamp).
    match /loyalty_cards/{cardId} {
      // NOTE: `resource == null` covers the first-visit case — the customer
      // must be allowed to `.get()` their card even before it exists.
      allow read: if signedIn()
        && (
          isAdmin()
          || resource == null
          || resource.data.customerUid == request.auth.uid
          || isPlaceOwner(resource.data.placeId)
        );

      // Create: safe starting state only — nobody may mint stamps or a
      // pre-claimed card through the client.
      // (a) the customer creates their own card on first stamp request, or
      // (b) the place owner / admin creates it inside the approval
      //     transaction when the doc does not exist yet (first stamp).
      allow create: if verifiedEmail()
        && request.resource.data.placeId is string
        && request.resource.data.customerUid is string
        && cardId == (request.resource.data.placeId + "_" + request.resource.data.customerUid)
        && request.resource.data.claimed == false
        && request.resource.data.claimRequested == false
        && (
          (
            request.resource.data.customerUid == request.auth.uid
            && request.resource.data.stamps == 0
          )
          || (
            (isPlaceOwner(request.resource.data.placeId) || isAdmin())
            && request.resource.data.stamps == 1
          )
        );

      // Update: owners/admins run approvals and claim marking (stamps,
      // claimed state). A customer may only flip their own claim-request
      // fields — never stamps, claimed, placeId or customerUid.
      allow update: if isAdmin()
        || (verifiedEmail() && isPlaceOwner(resource.data.placeId)
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.customerUid == resource.data.customerUid)
        || (
          verifiedEmail()
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.stamps == resource.data.stamps
          && request.resource.data.claimed == resource.data.claimed
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["claimRequested", "claimRequestedAt", "updatedAt"])
        );

      allow delete: if isAdmin()
        || (verifiedEmail() && isPlaceOwner(resource.data.placeId));
    }

    // stamp_requests/{requestId}: Owner-tap approval flow.
    match /stamp_requests/{requestId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.customerUid == request.auth.uid
          || isPlaceOwner(resource.data.placeId)
        );

      // Customers create only their own pending requests.
      allow create: if verifiedEmail()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.placeId is string
        && request.resource.data.status == "pending";

      // Owner approves/rejects; a customer may cancel their own request
      // without touching any other field.
      allow update: if isAdmin()
        || (verifiedEmail() && isPlaceOwner(resource.data.placeId)
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.customerUid == resource.data.customerUid)
        || (
          verifiedEmail()
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "updatedAt"])
        );

      allow delete: if isAdmin()
        || (verifiedEmail() && isPlaceOwner(resource.data.placeId));
    }
  }
}

